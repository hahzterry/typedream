# Copy to .env.local

# fal.ai key (https://fal.ai/dashboard/keys). Used for Seedance video + Seedream reference images.
FAL_KEY=

# Default provider for NEW projects: fal | ark | mock  (mock = free local ffmpeg test pattern). Changeable per project in Settings.
TYPEDREAM_PROVIDER=fal

# Image model used for "generate reference image" (fal endpoint id)
IMAGE_MODEL=fal-ai/bytedance/seedream/v4/text-to-image

# --- Optional: BytePlus ModelArk (official ByteDance hosting; experimental) ---
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# ARK_MODEL_SEEDANCE_2_0=
# ARK_MODEL_SEEDANCE_2_5=

# Where projects are stored (default ./data)
# TYPEDREAM_DATA_DIR=
