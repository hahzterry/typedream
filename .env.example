# Copy to .env.local

# fal.ai key (https://fal.ai/dashboard/keys). Used for Seedance video + Seedream reference images.
FAL_KEY=

# Provider used for new takes: fal | ark | mock  (mock = free local ffmpeg test pattern)
HARNESS_PROVIDER=fal

# Image model used for "generate reference" (fal endpoint id)
IMAGE_MODEL=fal-ai/bytedance/seedream/v4/text-to-image

# --- Optional: BytePlus ModelArk (official ByteDance hosting; experimental) ---
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# ARK_MODEL_SEEDANCE_2_0=
# ARK_MODEL_SEEDANCE_2_5=

# Where state, refs and videos are stored (default ./data)
# HARNESS_DATA_DIR=
